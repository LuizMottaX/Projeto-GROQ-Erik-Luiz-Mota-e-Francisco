# =============================================================
# Ditado — variáveis de ambiente
# Copie para .env (ou rode ./scripts/setup.sh) e preencha.
# Usado APENAS pelo backend e pelo docker-compose.
# O frontend NÃO possui .env.
# =============================================================

# --- Ambiente ---
NODE_ENV=development

# --- PostgreSQL (docker-compose + TypeORM) ---
POSTGRES_USER=ditado
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=ditado
DB_HOST=127.0.0.1
# Porta no host (sempre ligada a 127.0.0.1). 5433 para não conflitar
# com outro PostgreSQL local na 5432.
DB_PORT=5433

# --- Backend ---
PORT=3000

# --- JWT ---
# Gere com: openssl rand -hex 32
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=1d

# --- Groq ---
GROQ_API_KEY=gsk_sua_chave_aqui
GROQ_MODEL=whisper-large-v3-turbo

# --- Administrador inicial (criado na inicialização se não existir admin) ---
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@ditado.local
ADMIN_PASSWORD=troque-esta-senha-admin
